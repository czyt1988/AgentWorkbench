{
    "agents": [
        {
            "id": "kimi-code",
            "name": "Kimi Code",
            "command": "kimi web",
            "webUrl": "http://127.0.0.1:58627",
            "configDir": "%USERPROFILE%/.kimi-code",
            "icon": "qrc:/icons/kimi-code.svg",
            "color": "#FF6B35",
            "installCommand": "npm install -g @moonshot-ai/kimi-code@latest",
            "updateCommand": "npm install -g @moonshot-ai/kimi-code@latest",
            "versionCommand": "kimi --version"
        },
        {
            "id": "opencode",
            "name": "OpenCode",
            "command": "opencode web --port 4096",
            "webUrl": "http://127.0.0.1:4096",
            "configDir": "%USERPROFILE%/.config/opencode",
            "icon": "qrc:/icons/opencode.svg",
            "color": "#3B82F6",
            "installCommand": "npm install -g opencode-ai@latest",
            "updateCommand": "npm install -g opencode-ai@latest",
            "versionCommand": "opencode --version"
        },
        {
            "id": "qwen-code",
            "name": "Qwen Code",
            "command": "qwen serve",
            "webUrl": "http://127.0.0.1:4170",
            "configDir": "%USERPROFILE%/.qwen",
            "icon": "qrc:/icons/qwen-code.svg",
            "color": "#8B5CF6",
            "installCommand": "npm install -g @qwen-code/qwen-code@latest",
            "updateCommand": "npm install -g @qwen-code/qwen-code@latest",
            "versionCommand": "qwen --version",
            "setupCommand": "if not exist \"%USERPROFILE%\\.qwen-serve-token\" powershell -NoProfile -Command \"[guid]::NewGuid().ToString('N')+[guid]::NewGuid().ToString('N')\" > \"%USERPROFILE%\\.qwen-serve-token\"",
            "tokenFile": "%USERPROFILE%/.qwen-serve-token"
        },
        {
            "id": "openclaw",
            "name": "OpenClaw",
            "command": "openclaw gateway --port 18789 --verbose",
            "webUrl": "http://127.0.0.1:18789",
            "configDir": "%USERPROFILE%/.openclaw",
            "icon": "qrc:/icons/openclaw.svg",
            "color": "#DC2626",
            "installCommand": "npm install -g openclaw@latest",
            "updateCommand": "npm install -g openclaw@latest",
            "versionCommand": "openclaw --version"
        },
        {
            "id": "deepseek-harness",
            "name": "DeepSeek Harness",
            "command": "dsh web",
            "webUrl": "http://127.0.0.1:3080",
            "configDir": "%USERPROFILE%/.dsh",
            "icon": "qrc:/icons/deepseek-harness.svg",
            "color": "#4D6BFE",
            "installCommand": "npm install -g @deepseek-ai/dsh@latest",
            "updateCommand": "npm install -g @deepseek-ai/dsh@latest",
            "versionCommand": "dsh --version"
        }
    ]
}
