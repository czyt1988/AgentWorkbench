       VALUE "CompanyName", "AgentWorkbench contributors"
       VALUE "FileDescription", "AgentWorkbench"
       VALUE "FileVersion", "0.4.0"
       VALUE "InternalName", "AgentWorkbench"
       VALUE "OriginalFilename", "AgentWorkbench.exe"
       VALUE "ProductName", "AgentWorkbench"
       VALUE "ProductVersion", "0.4.0"
     END
   END
   BLOCK "VarFileInfo"
   BEGIN
     VALUE "Translation", 0x409, 1200
   END
 END
